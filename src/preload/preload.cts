  readThread: () => ipcRenderer.invoke(channels.read),
  startTurn: (prompt: string, nativeThreadId: string, preferences: unknown) => ipcRenderer.invoke(channels.turn, String(prompt ?? ""), String(nativeThreadId ?? "").slice(0, 256), preferences),
