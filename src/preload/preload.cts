  inspectPersistence: () => ipcRenderer.invoke(channels.persistenceInspect),
  listProjects: () => ipcRenderer.invoke(channels.projectList),
  createProject: (input: unknown) => ipcRenderer.invoke(channels.projectCreate, input),
